{
  "name": "@alexandrealvaro/agentic",
  "version": "0.20.0-beta.11",
  "description": "Bootstrap and audit AGENTS.md, ARCHITECTURE.md, ADRs, skills, and subagents for engineering production code with LLMs",
  "type": "module",
  "bin": {
    "agentic": "bin/agentic.js"
  },
  "files": [
    "bin/",
    "src/",
    "WORKFLOW.md",
    "WORKFLOW-FLOWS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node bin/agentic.js",
    "release": "./scripts/release.sh",
    "lint": "eslint .",
    "format:check": "prettier --check \"bin/**/*.js\" \"src/**/*.js\" \"scripts/**/*.{js,mjs}\" \"test/**/*.js\" \"eslint.config.js\" \".prettierrc.json\" \"package*.json\" \".github/**/*.yml\" \"lefthook.yml\"",
    "security:audit": "npm audit --audit-level=high",
    "test": "node bin/agentic.js --help && node bin/agentic.js init --help && node bin/agentic.js update --help && node bin/agentic.js uninstall --help && node scripts/run-tests.mjs",
    "verify": "npm run lint && npm run format:check && npm test && npm run security:audit",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "llm",
    "agents",
    "agentic",
    "spec-driven",
    "scaffolding",
    "ai",
    "claude-code",
    "agents-md"
  ],
  "license": "MIT",
  "author": "Alexandre Alvaro <alexandre.alvaro@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandremendoncaalvaro/agentic-development.git"
  },
  "bugs": {
    "url": "https://github.com/alexandremendoncaalvaro/agentic-development/issues"
  },
  "homepage": "https://github.com/alexandremendoncaalvaro/agentic-development#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "js-yaml": "^4.3.2",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6"
  }
}
